{
  // Tenang. worker.js is generated by scripts/build-worker.mjs; deploy with: npx wrangler deploy
  "name": "tenang",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] }, // push reminders: checks every minute for due reminders
  "d1_databases": [
    { "binding": "DB", "database_name": "tenang-push", "database_id": "d6344a98-e6d5-4a2d-9d4a-4ba3f02bdb03", "migrations_dir": "migrations" }
  ],
  "vars": {
    "VAPID_PUBLIC": "BA4qiMMyHMiOCQNwP-2k6egC_C4o0lnAaYB1r5OD16_m-FgOG2BNITgsBOvVxGYYbjG8vr-Df5pfAoRkw1JBddQ",
    "VAPID_SUB": "https://tenang.pm2120600.workers.dev"
  }
  // Secret (never commit): VAPID_PRIVATE_JWK, set with: npx wrangler secret put VAPID_PRIVATE_JWK
}
